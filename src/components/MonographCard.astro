---
const { book } = Astro.props;
---
<article class="monograph-card" data-book-card data-category={book.categoryKey}>
  <a href={`/monografie/${book.slug}`} aria-label={`Zobacz książkę: ${book.title}`}>
    <div class="monograph-card-cover">
      <img src={book.cover} alt={`Okładka książki: ${book.title}`} width={book.coverWidth} height={book.coverHeight} loading="lazy" />
      {book.featured && <span class="monograph-featured">Główne osiągnięcie</span>}
    </div>
    <div class="monograph-card-body">
      <div class="monograph-card-meta"><span>{book.categoryLabel}</span><span>{book.year}</span></div>
      <h2 class="notranslate" translate="no">{book.title}</h2>
      <p>{book.roleShort}</p>
      <strong>Zobacz książkę <span aria-hidden="true">→</span></strong>
    </div>
  </a>
</article>
