---
import { site } from '../data/site';
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div><strong>{site.name}</strong><p>{site.footerTagline}</p></div>
    <div class="footer-links">
      <a href={site.orcid} target="_blank" rel="noopener">ORCID</a>
      <a href="/analizy/">Analizy</a>
      <a href="/ankieta-smart-city/">Ankieta Smart City</a>
      <a class="footer-email-v5421" href={`mailto:${site.scientificEmail}`}>
        <span>Nauka</span>
        <strong>{site.scientificEmail}</strong>
      </a>
      <a class="footer-email-v5421" href={`mailto:${site.industryEmail}`}>
        <span>Branża</span>
        <strong>{site.industryEmail}</strong>
      </a>
      <a href="/bezpieczenstwo/">Bezpieczeństwo</a>
      <a href="/polityka-prywatnosci/">Prywatność</a>
      <button type="button" class="cookie-settings-footer-v5431" data-cookie-settings>Ustawienia cookies</button>
      {import.meta.env.DEV && <a href="/admin" rel="nofollow">Panel lokalny</a>}
      <span>© {new Date().getFullYear()}</span>
    </div>
  </div>
</footer>
