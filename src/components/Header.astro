---
import { navigation, site, visibility } from '../data/site';
import LanguageSwitcher from './LanguageSwitcher.astro';

type NavigationItem = {
  href: string;
  label: string;
  children?: Array<{ href: string; label: string }>;
};

const current = Astro.url.pathname;
const visibleNavigation = (navigation as NavigationItem[]).map((item) => ({
  ...item,
  children: item.children?.filter(
    (child) => child.href !== '/asystent' || visibility.showAssistantInNavigation
  ),
}));

const isCurrent = (href: string) =>
  current === href || current.startsWith(`${href}/`);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand notranslate" translate="no" href="/" aria-label={`${site.name} — strona główna`}>
      <span class="brand-mark">{site.logoText}</span>
      <span>{site.name}</span>
    </a>
    <button class="menu-button" data-menu-toggle aria-label="Otwórz menu"><span></span><span></span><span></span></button>
    <nav class="navigation" data-menu aria-label="Nawigacja główna">
      {visibleNavigation.map((item) => {
        const hasChildren = Boolean(item.children?.length);
        const activeChild = item.children?.some((child) => isCurrent(child.href));

        return hasChildren ? (
          <div class:list={['navigation-group', { 'has-active-child': activeChild }]}>
            <a
              class="navigation-parent"
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}<span class="navigation-caret" aria-hidden="true">⌄</span>
            </a>
            <div class="navigation-submenu" aria-label={`${item.label} — podmenu`}>
              {item.children?.map((child) => (
                <a href={child.href} aria-current={isCurrent(child.href) ? 'page' : undefined}>
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        );
      })}
      <LanguageSwitcher compact={true} />
      <button class="theme-button" data-theme-toggle aria-label="Zmień motyw">◐</button>
    </nav>
  </div>
</header>
