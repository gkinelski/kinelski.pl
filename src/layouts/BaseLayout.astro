---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { site, theme } from '../data/site';
import typography from '../data/typography.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  preloadImage?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = site.title,
  description = site.description,
  image = '/og-v5422.jpg',
  imageAlt = 'KINELSKI.PL — Grzegorz Kinelski: nauka, energetyka i zarządzanie',
  imageWidth = 1200,
  imageHeight = 630,
  preloadImage,
  noindex = false,
  structuredData = [],
} = Astro.props;

const canonicalPath =
  Astro.url.pathname === '/' || Astro.url.pathname.endsWith('/')
    ? Astro.url.pathname
    : `${Astro.url.pathname}/`;
const canonical = new URL(canonicalPath, site.url);
const isHomepage = Astro.url.pathname === '/';
const fullTitle = title === site.title ? title : `${title} | ${site.name}`;
const absoluteImage = new URL(image, site.url);
const robotsContent = noindex
  ? 'noindex,nofollow,noarchive'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';

const themeCss = `:root{--theme-primary:${theme.primary};--theme-primary-dark:${theme.primaryDark};--theme-navy:${theme.navy};--theme-navy-soft:${theme.navySoft};--theme-light-bg:${theme.light.background};--theme-light-surface:${theme.light.surface};--theme-light-surface-soft:${theme.light.surfaceSoft};--theme-light-text:${theme.light.text};--theme-light-muted:${theme.light.muted};--theme-light-line:${theme.light.line};--theme-dark-bg:${theme.dark.background};--theme-dark-surface:${theme.dark.surface};--theme-dark-surface-soft:${theme.dark.surfaceSoft};--theme-dark-text:${theme.dark.text};--theme-dark-muted:${theme.dark.muted};--theme-dark-line:${theme.dark.line};}`;

const finite = (value: unknown, fallback: number, min: number, max: number) => {
  const parsed = Number(value);
  if (!Number.isFinite(parsed)) return fallback;
  return Math.min(max, Math.max(min, parsed));
};
const rounded = (value: number) => Math.round(value * 100) / 100;
const px = (value: unknown, fallback: number, min: number, max: number, factor: number) =>
  `${rounded(finite(value, fallback, min, max) * factor)}px`;
const pxCapped = (value: unknown, fallback: number, min: number, max: number, factor: number, finalMin: number, finalMax: number) =>
  `${rounded(Math.min(finalMax, Math.max(finalMin, finite(value, fallback, min, max) * factor)))}px`;
const vw = (value: unknown, fallback: number, min: number, max: number, factor: number) =>
  `${rounded(finite(value, fallback, min, max) * factor)}vw`;

const globalScale = finite(typography.scale, 1, 0.75, 1.4);
const tabletScale = finite(typography.responsive?.tabletScale, 0.97, 0.75, 1.15);
const mobileScale = finite(typography.responsive?.mobileScale, 0.92, 0.7, 1.15);
const lineHeight = finite(typography.body?.lineHeight, 1.65, 1.2, 2.1);

const typographyVariables = (factor: number) => [
  `--type-body:${px(typography.body?.fontSize, 16, 13, 24, factor)}`,
  `--type-line-height:${rounded(lineHeight)}`,
  `--type-lead:${px(typography.body?.leadSize, 18, 14, 30, factor)}`,
  `--type-large-lead:${px(typography.body?.largeLeadSize, 25, 16, 36, factor)}`,
  `--type-detail-lead:${px(typography.body?.detailLeadSize, 20, 15, 32, factor)}`,
  `--type-brand:${pxCapped(typography.navigation?.brandSize, 16, 12, 28, factor, 12, 24)}`,
  `--type-navigation:${pxCapped(typography.navigation?.menuSize, 14, 11, 24, factor, 11, 18)}`,
  `--type-language:${pxCapped(typography.navigation?.languageSize, 11, 9, 20, factor, 9, 15)}`,
  `--type-navigation-height:${pxCapped(typography.navigation?.headerHeight, 78, 58, 112, factor, 58, 104)}`,
  `--type-navigation-gap:${pxCapped(typography.navigation?.gap, 22, 8, 42, factor, 8, 28)}`,
  `--type-hero-min:${px(typography.headings?.heroMin, 58, 34, 100, factor)}`,
  `--type-hero-fluid:${vw(typography.headings?.heroFluidVw, 8, 3, 13, factor)}`,
  `--type-hero-max:${px(typography.headings?.heroMax, 100, 58, 150, factor)}`,
  `--type-page-min:${px(typography.headings?.pageMin, 54, 30, 90, factor)}`,
  `--type-page-fluid:${vw(typography.headings?.pageFluidVw, 7.4, 2.5, 12, factor)}`,
  `--type-page-max:${px(typography.headings?.pageMax, 94, 48, 132, factor)}`,
  `--type-section-min:${px(typography.headings?.sectionMin, 38, 24, 68, factor)}`,
  `--type-section-fluid:${vw(typography.headings?.sectionFluidVw, 5, 2, 9, factor)}`,
  `--type-section-max:${px(typography.headings?.sectionMax, 60, 36, 96, factor)}`,
  `--type-card-title:${px(typography.headings?.cardTitle, 30, 16, 42, factor)}`,
  `--type-small-title:${px(typography.headings?.smallTitle, 20, 14, 34, factor)}`,
  `--type-eyebrow:${px(typography.components?.eyebrowSize, 12, 9, 20, factor)}`,
  `--type-button:${px(typography.components?.buttonSize, 16, 12, 24, factor)}`,
  `--type-button-height:${px(typography.components?.buttonHeight, 50, 38, 72, factor)}`,
  `--type-form:${px(typography.components?.formSize, 16, 12, 24, factor)}`,
  `--type-form-label:${px(typography.components?.formLabelSize, 11, 9, 18, factor)}`,
  `--type-form-height:${px(typography.components?.formHeight, 46, 36, 68, factor)}`,
  `--type-metadata:${px(typography.components?.metadataSize, 11, 9, 18, factor)}`,
  `--type-metric-home:${px(typography.metrics?.homeValueSize, 36, 22, 62, factor)}`,
  `--type-metric-publication:${px(typography.metrics?.publicationValueSize, 31, 20, 58, factor)}`,
  `--type-metric-books:${px(typography.metrics?.booksValueSize, 44, 24, 70, factor)}`,
  `--type-metric-career:${px(typography.metrics?.careerValueSize, 37, 22, 64, factor)}`,
  `--type-metric-label:${px(typography.metrics?.labelSize, 11, 9, 18, factor)}`,
  `--type-footer:${px(typography.components?.footerSize, 14, 11, 22, factor)}`,
  `--type-publication-title:${px(typography.content?.publicationTitleSize, 27, 18, 44, factor)}`,
  `--type-monograph-title:${px(typography.content?.monographTitleSize, 25, 17, 44, factor)}`,
  `--type-career-title:${px(typography.content?.careerCardTitleSize, 25, 17, 44, factor)}`,
  `--type-card-body:${px(typography.content?.cardBodySize, 16, 12, 24, factor)}`,
].join(';');

const typographyCss = `:root{${typographyVariables(globalScale)}}@media(max-width:980px){:root{${typographyVariables(globalScale * tabletScale)}}}@media(max-width:650px){:root{${typographyVariables(globalScale * mobileScale)}}}`;
const designCss = `${themeCss}${typographyCss}`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.name,
  honorificPrefix: 'dr',
  url: site.url,
  mainEntityOfPage: `${site.url}/o-mnie/`,
  image: {
    '@type': 'ImageObject',
    url: `${site.url}/images/grzegorz-kinelski.webp`,
    width: 360,
    height: 480,
  },
  description: site.description,
  jobTitle: site.role,
  affiliation: [
    {
      '@type': 'CollegeOrUniversity',
      name: site.affiliation,
      url: 'https://wsb.edu.pl',
    },
    {
      '@type': 'Organization',
      name: 'Enea S.A.',
      url: 'https://www.enea.pl',
    },
  ],
  identifier: [
    {
      '@type': 'PropertyValue',
      propertyID: 'ORCID',
      value: '0000-0002-5768-463X',
      url: site.orcid,
    },
    {
      '@type': 'PropertyValue',
      propertyID: 'Web of Science ResearcherID',
      value: 'AAA-3088-2020',
      url: 'https://www.webofscience.com/wos/author/record/AAA-3088-2020',
    },
  ],
  knowsAbout: [
    'Smart City',
    'transformacja energetyczna',
    'gospodarka cyfrowa',
    'rezyliencja miejska',
    'zarządzanie organizacjami infrastrukturalnymi',
    'bezpieczeństwo energetyczne',
  ],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'kontakt naukowy',
      email: site.scientificEmail,
    },
    {
      '@type': 'ContactPoint',
      contactType: 'kontakt branżowy',
      email: site.industryEmail,
    },
  ],
  sameAs: site.sameAs ?? [site.orcid],
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.title,
  alternateName: 'KINELSKI.PL',
  description: site.description,
  inLanguage: 'pl-PL',
  publisher: {
    '@id': `${site.url}/#person`,
  },
};
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical.href}#webpage`,
  url: canonical.href,
  name: fullTitle,
  description,
  inLanguage: 'pl-PL',
  isPartOf: {
    '@id': `${site.url}/#website`,
  },
  about: {
    '@id': `${site.url}/#person`,
  },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: absoluteImage.href,
    width: imageWidth,
    height: imageHeight,
  },
};
const additionalSchemas = Array.isArray(structuredData) ? structuredData : [structuredData];
---
<!doctype html>
<html lang="pl" data-language="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content={theme.navy} />
  <meta name="author" content={site.name} />
  {isHomepage && <meta name="google-site-verification" content="61rjJcRlqM_ra-WvC5WYwY069AHtckMgKcg4MgD19PE" />}
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="robots" content={robotsContent} />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="author" href="/o-mnie" />
  <link rel="help" href="/bezpieczenstwo" />
  <link rel="me" href={site.orcid} />
  {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:site_name" content="KINELSKI.PL" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={absoluteImage} />
  <meta property="og:image:secure_url" content={absoluteImage} />
  <meta property="og:image:width" content={String(imageWidth)} />
  <meta property="og:image:height" content={String(imageHeight)} />
  <meta property="og:image:alt" content={imageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteImage} />
  <meta name="twitter:image:alt" content={imageAlt} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  {additionalSchemas.map((schema) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
  <style is:global set:html={designCss}></style>
</head>
<body>
  <a class="skip-link" href="#main">Przejdź do treści</a>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <script is:inline src="/i18n-public.js" defer></script>
  <script is:inline>
    const root = document.documentElement;
    const saved = localStorage.getItem('theme');
    if (saved === 'dark') root.dataset.theme = 'dark';
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      localStorage.setItem('theme', next);
    });
    const menu = document.querySelector('[data-menu]');
    document.querySelector('[data-menu-toggle]')?.addEventListener('click', () => menu?.toggleAttribute('data-open'));
  </script>
</body>
</html>
