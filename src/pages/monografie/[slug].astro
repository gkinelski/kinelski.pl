---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalogue from '../../data/monographs.json';
type Book=(typeof catalogue.items)[number];
export function getStaticPaths(){return catalogue.items.filter((book)=>book.detailType!=='extended').map((book)=>({params:{slug:book.slug},props:{book,related:catalogue.items.filter((item)=>item.categoryKey===book.categoryKey&&item.slug!==book.slug).slice(0,2)}}));}
interface Props{book:Book;related:Book[];}
const {book,related}=Astro.props;
const people=book.authors.length?book.authors:book.editors;
const schema={'@context':'https://schema.org','@type':'Book',name:book.title,datePublished:String(book.year),inLanguage:book.language,isbn:book.isbn||undefined,author:book.authors.map((name)=>({'@type':'Person',name})),editor:book.editors.map((name)=>({'@type':'Person',name})),publisher:{'@type':'Organization',name:book.publisher},image:new URL(book.cover,'https://kinelski.pl').href};
---
<BaseLayout title={book.title} description={book.lead} image={book.cover}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="book-detail-hero">
    <div class="container"><a class="book-back-link" href="/monografie">← Wszystkie monografie</a></div>
    <div class="container book-detail-hero-grid">
      <figure class="book-detail-cover"><img src={book.cover} alt={`Okładka książki: ${book.title}`} width={book.coverWidth} height={book.coverHeight} /></figure>
      <div class="book-detail-copy">
        <div class="book-detail-kickers"><span>{book.categoryLabel}</span><span>{book.year}</span></div>
        <h1 class="notranslate" translate="no">{book.title}</h1>
        <p class="book-detail-lead">{book.lead}</p>
        <div class="book-role-box"><span>Rola Grzegorza Kinelskiego</span><strong>{book.role}</strong></div>
        <div class="book-detail-actions">{book.externalUrl && <a class="button primary" href={book.externalUrl} target="_blank" rel="noopener">{book.externalLabel} ↗</a>}<a class="button secondary" href="#charakterystyka">Charakterystyka</a></div>
      </div>
    </div>
  </section>

  <section class="section" id="charakterystyka"><div class="container book-detail-main-grid">
    <div><p class="eyebrow">Charakterystyka</p><h2>Zakres i znaczenie książki</h2></div>
    <div class="book-detail-prose">{book.description.map((paragraph)=><p>{paragraph}</p>)}<div class="book-topic-list">{book.topics.map((topic)=><span>{topic}</span>)}</div></div>
  </div></section>

  <section class="section book-contributions-section"><div class="container">
    <div class="section-heading"><div><p class="eyebrow">Wkład i rola</p><h2>Udział w powstaniu książki</h2></div><p>Klasyfikacja odróżnia autorstwo całej monografii, współautorstwo książki oraz odpowiedzialność redakcyjną za tom zbiorowy.</p></div>
    <div class="book-contribution-grid">{book.contributions.map((item,index)=><article><span>{String(index+1).padStart(2,'0')}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
  </div></section>

  <section class="section"><div class="container book-data-grid">
    <div><p class="eyebrow">Metadane</p><h2>Dane wydawnicze</h2></div>
    <dl class="book-data-table">
      <div><dt>Typ</dt><dd>{book.categoryLabel}</dd></div>
      <div><dt>{book.authors.length?'Autorzy':'Redaktorzy naukowi'}</dt><dd class="notranslate" translate="no">{people.join(', ')}</dd></div>
      {book.editors.length>0 && book.authors.length>0 && <div><dt>Redakcja naukowa</dt><dd class="notranslate" translate="no">{book.editors.join(', ')}</dd></div>}
      <div><dt>Wydawnictwo</dt><dd>{book.publisher}{book.place?`, ${book.place}`:''}</dd></div>
      <div><dt>Rok / język</dt><dd>{book.year} • {book.language}</dd></div>
      {book.pages && <div><dt>Objętość</dt><dd>{book.pages} stron</dd></div>}
      {book.isbn && <div><dt>ISBN</dt><dd class="notranslate" translate="no">{book.isbn}</dd></div>}
      {book.eisbn && <div><dt>e-ISBN</dt><dd class="notranslate" translate="no">{book.eisbn}</dd></div>}
      {book.doi && <div><dt>DOI</dt><dd class="notranslate" translate="no">{book.doi}</dd></div>}
    </dl>
  </div></section>

  <section class="section citation-section-books"><div class="container citation-grid">
    <div><p class="eyebrow">Cytowanie</p><h2>Opis bibliograficzny</h2></div>
    <div class="citation-panel"><p id="book-citation" class="notranslate" translate="no">{book.citation}</p><div class="actions"><button class="button primary" type="button" data-copy-book>Kopiuj opis</button>{book.externalUrl && <a class="button secondary" href={book.externalUrl} target="_blank" rel="noopener">Źródło ↗</a>}</div></div>
  </div></section>

  {related.length>0 && <section class="section related-books-section"><div class="container"><p class="eyebrow">Ta sama kategoria</p><h2>Zobacz także</h2><div class="related-books-grid">{related.map((item)=><a href={`/monografie/${item.slug}`}><img src={item.cover} alt={`Okładka: ${item.title}`} width={item.coverWidth} height={item.coverHeight}/><div><span>{item.year}</span><h3 class="notranslate" translate="no">{item.title}</h3></div></a>)}</div></div></section>}
  <script>document.querySelector('[data-copy-book]')?.addEventListener('click',async(event)=>{const citation=document.querySelector('#book-citation')?.textContent?.trim();if(!citation)return;await navigator.clipboard.writeText(citation);const button=event.currentTarget;if(!(button instanceof HTMLButtonElement))return;const old=button.textContent;button.textContent='Skopiowano';setTimeout(()=>button.textContent=old,1300);});</script>
</BaseLayout>
