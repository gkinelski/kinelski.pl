---
import BaseLayout from '../layouts/BaseLayout.astro';
import portfolio from '../data/energyProjects.json';

const projectCount = portfolio.organisations.reduce((sum, organisation) => sum + organisation.projects.length, 0);
const projectCategory = (type: string) => {
  if (['Integracja', 'Cyfryzacja', 'Handel', 'Sprzedaż'].includes(type)) return 'wdrozeniowe';
  if (['Restrukturyzacja'].includes(type)) return 'organizacyjne';
  return 'strategiczne';
};
---
<BaseLayout
  title="Projekty energetyczne"
  description="Interaktywna mapa wybranych projektów energetycznych, transformacyjnych, handlowych i cyfrowych Grzegorza Kinelskiego."
>
  <section class="projects-hero-v54">
    <div class="container">
      <p class="eyebrow">{portfolio.meta.eyebrow}</p>
      <div class="projects-hero-grid-v54">
        <div>
          <h1>{portfolio.meta.title}</h1>
          <p class="page-lead">{portfolio.meta.lead}</p>
        </div>
        <p class="projects-hero-note-v54">{portfolio.meta.note}</p>
      </div>
      <div class="projects-metrics-v54">
        {portfolio.metrics.map((metric) => <article><strong>{metric.value}</strong><span>{metric.label}</span></article>)}
      </div>
    </div>
  </section>

  <section class="section projects-explorer-v54">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">Interaktywna mapa</p><h2>Organizacje i programy zmian</h2></div>
        <p>Wybierz punkt lub nazwę organizacji, aby zobaczyć powiązane projekty, role i rezultaty.</p>
      </div>
      <div class="projects-type-filter-v5416" data-project-type-filters>
        <span>Rodzaj przedsięwzięcia</span>
        <div>
          <button class="is-active" type="button" data-project-type="all">Wszystkie</button>
          <button type="button" data-project-type="strategiczne">Strategiczne</button>
          <button type="button" data-project-type="wdrozeniowe">Wdrożeniowe</button>
          <button type="button" data-project-type="organizacyjne">Organizacyjne</button>
        </div>
        <p><strong data-visible-projects>{projectCount}</strong> widocznych projektów</p>
      </div>

      <div class="projects-map-layout-v54">
        <div class="projects-map-v54" role="group" aria-label="Mapa organizacji energetycznych">
          <div class="projects-map-shape-v54" aria-hidden="true">
            <img src="/images/poland-outline.svg" alt="" width="600" height="600" loading="lazy" decoding="async" />
            <span>POLSKA</span>
          </div>
          {portfolio.organisations.map((organisation, index) => (
            <button
              type="button"
              class:list={['projects-map-node-v54', { 'is-active': index === 0 }]}
              style={`--node-x:${organisation.mapPosition.x}%;--node-y:${organisation.mapPosition.y}%`}
              data-project-select={organisation.id}
              aria-label={`${organisation.name}, ${organisation.city}`}
            >
              <span></span><strong>{organisation.name}</strong><small>{organisation.city}</small>
            </button>
          ))}
        </div>

        <div class="projects-organisations-v54" aria-label="Lista organizacji">
          {portfolio.organisations.map((organisation, index) => (
            <button type="button" class:list={{ 'is-active': index === 0 }} data-project-select={organisation.id}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div><strong>{organisation.name}</strong><small>{organisation.period}</small></div>
            </button>
          ))}
        </div>
      </div>

      <div class="projects-details-stack-v54">
        {portfolio.organisations.map((organisation, index) => (
          <article class="projects-detail-v54" data-project-panel={organisation.id} hidden={index !== 0}>
            <header>
              <div><p>{organisation.city} • {organisation.period}</p><h2>{organisation.name}</h2><strong>{organisation.role}</strong></div>
              <p>{organisation.summary}</p>
            </header>
            <div class="projects-area-tags-v54">{organisation.areas.map((area) => <span>{area}</span>)}</div>
            <div class="projects-cards-v54">
              {organisation.projects.map((project) => (
                <section data-project-card data-project-category={projectCategory(project.type)}>
                  <span>{project.type} • {projectCategory(project.type) === 'strategiczne' ? 'strategiczne' : projectCategory(project.type) === 'wdrozeniowe' ? 'wdrożeniowe' : 'organizacyjne'}</span>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                  <div><small>Rezultat</small><strong>{project.result}</strong></div>
                </section>
              ))}
            </div>
          </article>
        ))}
      </div>
      <p class="projects-total-v54">Portfolio obejmuje <strong>{projectCount}</strong> wybranych programów i wdrożeń. Opisy przedstawiają zakres odpowiedzialności menedżerskiej i rezultaty pracy zespołowej.</p>
    </div>
  </section>

  <script is:inline>
    (() => {
      const controls = [...document.querySelectorAll('[data-project-select]')];
      const panels = [...document.querySelectorAll('[data-project-panel]')];
      const typeButtons = [...document.querySelectorAll('[data-project-type]')];
      const visibleCount = document.querySelector('[data-visible-projects]');
      let selectedOrganisation = 'enea';
      let selectedType = 'all';
      const updateCards = () => {
        let visible = 0;
        document.querySelectorAll('[data-project-card]').forEach((card) => {
          const panel = card.closest('[data-project-panel]');
          const inSelectedOrganisation = panel?.dataset.projectPanel === selectedOrganisation;
          const matchesType = selectedType === 'all' || card.dataset.projectCategory === selectedType;
          card.hidden = !matchesType;
          if (inSelectedOrganisation && matchesType) visible += 1;
        });
        if (visibleCount) visibleCount.textContent = String(visible);
      };
      const select = (id) => {
        selectedOrganisation = id;
        controls.forEach((control) => {
          const active = control.dataset.projectSelect === id;
          control.classList.toggle('is-active', active);
          control.setAttribute('aria-pressed', String(active));
        });
        panels.forEach((panel) => { panel.hidden = panel.dataset.projectPanel !== id; });
        updateCards();
      };
      controls.forEach((control) => control.addEventListener('click', () => select(control.dataset.projectSelect)));
      typeButtons.forEach((button) => button.addEventListener('click', () => {
        selectedType = button.dataset.projectType;
        typeButtons.forEach((item) => item.classList.toggle('is-active', item === button));
        updateCards();
      }));
      select('enea');
    })();
  </script>
</BaseLayout>
