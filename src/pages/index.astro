---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import content from '../data/siteContent.json';
import publications from '../data/publications.json';
const { home, visibility } = content;
type Publication = (typeof publications)[number];
const featured: Publication[] = home.publications.featuredLp
  .map((lp) => publications.find((publication) => Number(publication.lp) === Number(lp)))
  .filter((publication): publication is Publication => publication !== undefined);
---
<BaseLayout preloadImage={home.hero.portrait}>
<section class="hero"><img class="hero-scene" src="/images/hero-energy-city-v5427-edge.webp" alt="" width="1774" height="887" aria-hidden="true" decoding="async"/><div class="hero-orbit hero-orbit-one"></div><div class="hero-orbit hero-orbit-two"></div>
<div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">{home.hero.eyebrow}</p><h1>{home.hero.firstName}<br/><span>{home.hero.lastName}</span></h1><p class="hero-specialisms">{home.hero.specialisms}</p><p class="hero-intro">{home.hero.intro}</p><p class="hero-detail">{home.hero.detail}</p><div class="actions"><a class="button primary" href={home.hero.primaryButton.href}>{home.hero.primaryButton.label}</a><a class="button secondary" href={home.hero.secondaryButton.href}>{home.hero.secondaryButton.label}</a></div></div>
<div class="portrait-shell"><div class="portrait-panel"><img src={home.hero.portrait} alt={home.hero.portraitAlt} width="360" height="480" loading="eager" fetchpriority="high" decoding="async" /></div><div class="portrait-note"><span>{home.hero.portraitKicker}</span><strong>{home.hero.portraitTitle}</strong></div></div></div>
<div class="container metrics">{home.metrics.map((item)=><article><strong>{item.value}</strong><span>{item.label}</span></article>)}</div></section>
<section class="home-pathways-v5413"><div class="container"><div class="home-pathways-intro-v5413"><p class="eyebrow">Trzy perspektywy</p><h2>Nauka, transformacja i współpraca</h2><p>Serwis łączy program badawczy, doświadczenie zarządcze oraz portfolio projektów wdrażanych w sektorze energii i środowisku akademickim.</p></div><div class="home-pathway-grid-v5413">
  <a href="/badania"><span>01</span><strong>Program badawczy</strong><p>Smart City, transformacja energetyczna, gospodarka cyfrowa i rezyliencja.</p><em>Przejdź do badań ↗</em></a>
  <a href="/kariera"><span>02</span><strong>Doświadczenie zarządcze</strong><p>Ponad trzy dekady pracy w energetyce, handlu, cyfryzacji i restrukturyzacji.</p><em>Zobacz karierę ↗</em></a>
  <a href="/projekty"><span>03</span><strong>Projekty i wdrożenia</strong><p>Programy zmian prowadzone w organizacjach infrastrukturalnych i energetycznych.</p><em>Otwórz mapę projektów ↗</em></a>
</div></div></section>
{visibility.profileSection && <section class="section"><div class="container editorial-grid"><div><p class="eyebrow">{home.profile.eyebrow}</p><h2>{home.profile.title}</h2></div><div class="editorial-copy"><p class="lead">{home.profile.lead}</p><p>{home.profile.text}</p><a class="text-link" href={home.profile.linkHref}>{home.profile.linkLabel}</a></div></div></section>}
{visibility.researchSection && <section class="section tinted"><div class="container"><SectionHeading eyebrow={home.research.eyebrow} title={home.research.title} text={home.research.text}/><div class="area-grid">{home.research.areas.map((area)=><a class="area-card" href={area.href}><span class="area-number">{area.number}</span><h3>{area.title}</h3><p>{area.text}</p><span class="card-arrow">↗</span></a>)}</div></div></section>}
<section class="home-analysis-callout-v5426"><div class="container home-analysis-callout-grid-v5426"><span>4T+</span><div><h2>Nowe analizy oparte na publikacjach</h2><p>Rezyliencja miast, model 4T+, akceptacja transformacji i cyfrowe bliźniaki — wyniki badań przełożone na praktykę.</p></div><a class="button primary" href="/analizy/">Czytaj analizy</a></div></section>
{visibility.monographSection && <section class="section dark-section"><div class="container monograph-grid"><div class="home-book-gallery"><span class="book-kicker">{home.monograph.kicker}</span><div class="home-book-stack"><img class="home-book-main" src="/images/monographs/rezyliencja-miast-inteligentnych.webp" alt="Okładka monografii Rezyliencja miast inteligentnych" width="988" height="1302" loading="lazy" decoding="async"/><img class="home-book-side home-book-side-a" src="/images/monographs/towards-climate-neutral-management.webp" alt="Okładka monografii Towards the Climate Neutral Management" width="988" height="1270" loading="lazy" decoding="async"/><img class="home-book-side home-book-side-b" src="/images/monographs/koncepcja-smart-city-4t.webp" alt="Okładka monografii Koncepcja Smart City i potencjały 4T" width="988" height="1338" loading="lazy" decoding="async"/></div></div><div><p class="eyebrow pale">{home.monograph.eyebrow}</p><h2>{home.monograph.title}</h2><p class="light-copy">{home.monograph.lead}</p><div class="method-metrics">{home.monograph.metrics.map((item)=><span><strong>{item.value}</strong>{item.label}</span>)}</div><a class="button light" href={home.monograph.buttonHref}>{home.monograph.buttonLabel}</a></div></div></section>}
{visibility.publicationsSection && <section class="section"><div class="container"><SectionHeading eyebrow={home.publications.eyebrow} title={home.publications.title} text={home.publications.text}/><div class="publication-preview">{featured.map((p,index)=><article class={index===0?'publication-main':''}><span>{p.year} • {p.type}</span><h3 class="notranslate" translate="no">{p.title}</h3>{index===0 && <p class="notranslate" translate="no">{p.authors}</p>}{p.doiUrl?<a href={p.doiUrl} target="_blank" rel="noopener">DOI →</a>:<a href="/publikacje">Zobacz →</a>}</article>)}</div></div></section>}
</BaseLayout>
