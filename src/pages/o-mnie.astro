---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Timeline from '../components/Timeline.astro';
import ProfileFact from '../components/ProfileFact.astro';
import profile from '../data/profile.json';
import { site } from '../data/site';

const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${site.url}/o-mnie/#profile`,
  url: `${site.url}/o-mnie/`,
  name: `Profil dr. ${site.name}`,
  description: 'Biogram, wykształcenie, doświadczenie menedżerskie i profil naukowy dr. Grzegorza Kinelskiego.',
  dateModified: '2026-07-31',
  inLanguage: 'pl-PL',
  isPartOf: {
    '@id': `${site.url}/#website`,
  },
  mainEntity: {
    '@id': `${site.url}/#person`,
  },
};
---
<BaseLayout title="O mnie" description="Biogram, wykształcenie, doświadczenie menedżerskie i profil naukowy dr. Grzegorza Kinelskiego." preloadImage={profile.hero.portrait} structuredData={profilePageSchema}>
<section class="about-hero"><div class="about-hero-orbit"></div><div class="container about-hero-grid"><div><p class="eyebrow">{profile.hero.eyebrow}</p><h1>{profile.hero.title}</h1><p class="page-lead">{profile.hero.lead}</p><div class="actions"><a class="button primary" href="#biogram">Czytaj biogram</a><a class="button secondary" href="/kontakt">Kontakt</a></div></div><div class="about-portrait-wrap"><img class="about-portrait" src={profile.hero.portrait} alt={profile.hero.portraitAlt} width="360" height="480" loading="eager" fetchpriority="high" decoding="async"/><div class="about-portrait-label"><span>{profile.hero.portraitKicker}</span><strong>{profile.hero.portraitTitle}</strong></div></div></div></section>
<section class="about-lenses-v5414"><div class="container"><div class="about-lenses-grid-v5414">
  <a href="/badania"><span>01</span><div><p>Perspektywa naukowa</p><h2>Badania zorientowane na problemy transformacji</h2><strong>Program 4T+, Smart City, rezyliencja i gospodarka cyfrowa ↗</strong></div></a>
  <a href="/kariera"><span>02</span><div><p>Perspektywa menedżerska</p><h2>Zarządzanie zmianą w organizacjach infrastrukturalnych</h2><strong>Energetyka, handel, cyfryzacja i restrukturyzacja ↗</strong></div></a>
  <a href="/aktywnosc"><span>03</span><div><p>Perspektywa ekspercka</p><h2>Łączenie wiedzy akademickiej z praktyką</h2><strong>Konferencje, projekty, dydaktyka i współpraca ↗</strong></div></a>
</div></div></section>
<section class="section" id="biogram"><div class="container about-editorial"><aside class="about-index"><p class="eyebrow">Na tej stronie</p><a href="#biogram">Biogram</a><a href="#profil">Profil</a><a href="#wyksztalcenie">Wykształcenie</a><a href="#kariera">Kariera</a><a href="#kwalifikacje">Kwalifikacje</a><a href="#wyroznienia">Wyróżnienia</a></aside><article class="about-copy"><p class="lead">{profile.biogram.lead}</p>{profile.biogram.paragraphs.map((paragraph)=><p>{paragraph}</p>)}<blockquote>„{profile.biogram.quote}”</blockquote></article></div></section>
<section class="section tinted" id="profil"><div class="container"><SectionHeading eyebrow="Profil interdyscyplinarny" title="Cztery perspektywy jednego programu" text="Kompetencje techniczne, ekonomiczne, menedżerskie i naukowe tworzą wspólny warsztat badawczy."/><div class="profile-facts-grid">{profile.perspectives.map((item)=><ProfileFact title={item.title} value={item.value} text={item.text}/>)}</div></div></section>
<section class="section" id="wyksztalcenie"><div class="container timeline-section-grid"><div class="timeline-intro"><p class="eyebrow">Edukacja</p><h2>Od elektroenergetyki do nauk o zarządzaniu</h2><p>Kolejne etapy edukacji odpowiadały na rosnącą złożoność problemów, z którymi spotykałem się w praktyce sektora energii.</p></div><Timeline items={profile.education} variant="education"/></div></section>
<section class="section career-section" id="kariera"><div class="container"><SectionHeading eyebrow="Doświadczenie" title="Ponad trzy dekady w energetyce" text="Przebieg kariery pokazuje przejście od doświadczenia branżowego do zarządzania transformacją dużych organizacji infrastrukturalnych."/><Timeline items={profile.career} variant="career"/></div></section>
<section class="section tinted" id="kwalifikacje"><div class="container"><SectionHeading eyebrow="Warsztat" title="Kwalifikacje uzupełniające" text="Formalne kompetencje wzmacniają projektowanie badań i aplikacyjny charakter rekomendacji."/><div class="qualification-grid">{profile.qualifications.map((item)=><article class="qualification-card"><span>{item.meta}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>
<section class="section recognition-section" id="wyroznienia"><div class="container recognition-grid"><div><p class="eyebrow pale">Oddziaływanie</p><h2>Wyróżnienia i role eksperckie</h2><p class="light-copy">Nagrody i funkcje środowiskowe traktuję jako zewnętrzne potwierdzenie zdolności przekładania wiedzy na praktykę zarządzania transformacją.</p></div><div class="recognition-list">{profile.recognition.map((item)=><article><span>{item.year}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div></div></section>
<section class="section"><div class="container about-cta"><div><p class="eyebrow">{profile.cta.eyebrow}</p><h2>{profile.cta.title}</h2><p>{profile.cta.text}</p></div><a class="button primary" href={profile.cta.href}>{profile.cta.label}</a></div></section>
</BaseLayout>
