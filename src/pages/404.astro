---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Nie znaleziono strony" description="Strona nie została znaleziona.">
  <section class="error-page">
    <div class="container">
      <span>404</span>
      <h1>Ta strona nie istnieje</h1>
      <p>Adres mógł zostać zmieniony albo wpisany niepoprawnie.</p>
      <div class="actions">
        <a class="button primary" href="/">Strona główna</a>
        <a class="button secondary" href="/asystent">Zapytaj o badania</a>
      </div>
    </div>
  </section>
</BaseLayout>
